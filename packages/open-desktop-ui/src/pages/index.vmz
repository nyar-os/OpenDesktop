<template>
    <div class="od-root">
        <header class="od-header">
            <div class="od-brand">
                <span class="od-mark">OD</span>
                <div class="od-brand-text">
                    <h1>{{ title }}</h1>
                    <p>{{ subtitle }}</p>
                </div>
            </div>
            <div class="od-header-actions">
                <button class="od-button od-button-secondary" type="button" @click="closeWindow">{{ closeLabel }}</button>
                <button class="od-button od-button-primary" type="button" :disabled="loading" @click="refresh">
                    {{ loading ? refreshBusyLabel : refreshLabel }}
                </button>
            </div>
        </header>

        <main class="od-main">
            <section class="od-summary">
                <div class="od-summary-item">
                    <span class="od-summary-label">{{ platformLabel }}</span>
                    <strong class="od-summary-value" data-state="available">{{ platform || '—' }}</strong>
                </div>
                <div class="od-summary-item">
                    <span class="od-summary-label">{{ loadedLabel }}</span>
                    <strong class="od-summary-value">{{ loadedAt || '—' }}</strong>
                </div>
                <div class="od-summary-item od-summary-wide">
                    <span class="od-summary-label">{{ noticeLabel }}</span>
                    <strong class="od-summary-value">{{ notice }}</strong>
                </div>
            </section>

            <section v-if="error" class="od-state od-state-error" role="alert">
                <h2>{{ errorTitle }}</h2>
                <p>{{ error }}</p>
                <button class="od-button od-button-secondary" type="button" @click="refresh">{{ retryLabel }}</button>
            </section>

            <section v-else-if="loading" class="od-state" role="status">
                <h2>{{ loadingTitle }}</h2>
                <p>{{ loadingDesc }}</p>
            </section>

            <section v-else-if="!rows.length" class="od-state">
                <h2>{{ emptyTitle }}</h2>
                <p>{{ emptyDesc }}</p>
                <button class="od-button od-button-secondary" type="button" @click="refresh">{{ refreshLabel }}</button>
            </section>

            <section v-else class="od-panel" :aria-label="tableLabel">
                <table class="od-table">
                    <thead>
                        <tr>
                            <th scope="col">{{ columnCapability }}</th>
                            <th scope="col">{{ columnState }}</th>
                            <th scope="col">{{ columnDetail }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="row in rows" :key="row.id">
                            <td class="od-cell-name">{{ row.name }}</td>
                            <td>
                                <span class="od-state-pill" :data-state="row.state">{{ row.state }}</span>
                            </td>
                            <td class="od-cell-detail">{{ row.detail }}</td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </main>

        <footer class="od-footer">
            <span>{{ footerHint }}</span>
            <span class="od-footer-code">wae.audit/v0</span>
        </footer>
    </div>
</template>

