</style>

<script client>
/**
 * Capability view for the host window.
 *
 * The page renders only the snapshot returned by the native IPC handler
 * (`{ type: "capabilities" }` → `{ type: "capabilitiesResult", report }`).
 * There is no mock data and no second capability model in the UI.
 */
export default class CapabilitiesPage {
    title = "OpenDesktop";
    subtitle = "Capability snapshot reported by the native capability face";
    notice = "Protocol backends stay unavailable until their contracts are implemented. Availability is reported, never inferred.";
    noticeLabel = "Notice";
    platformLabel = "Platform";
    loadedLabel = "Last refreshed";
    tableLabel = "Capability availability";
    columnCapability = "Capability";
    columnState = "State";
    columnDetail = "Detail";
    closeLabel = "Close";
    refreshLabel = "Refresh";
    refreshBusyLabel = "Refreshing";
    retryLabel = "Try again";
    loadingTitle = "Reading capabilities";
    loadingDesc = "Waiting for the native capability snapshot.";
    errorTitle = "Capability snapshot unavailable";
    emptyTitle = "No capability rows";
    emptyDesc = "The native layer returned an empty report.";
    footerHint = "Session, transport, and credential backends are not part of this build.";

    platform = "";
    rows = [];
    loading = true;
    error = "";
    loadedAt = "";

    onMount() {
        this.installHostBridge();
        const bridge = globalThis.chrome && globalThis.chrome.webview;
        if (bridge && bridge.postMessage) {
            this.refresh();
            return;
        }
        this.loading = false;
        this.error = "Native bridge unavailable. Open this page through the OpenDesktop host.";
    }

    installHostBridge() {
        const handler = (event) => {
            let data = event && typeof event === "object" && "data" in event ? event.data : event;
            if (typeof data === "string") {
                try {
                    data = JSON.parse(data);
                } catch {
                    return;
                }
            }
            this.handleReply(data);
        };
        const bridge = globalThis.chrome && globalThis.chrome.webview;
        if (bridge && bridge.addEventListener) bridge.addEventListener("message", handler);
        globalThis.__waeReceive = (text) => {
            try {
                handler(JSON.parse(text));
            } catch {
                // Ignore malformed host messages.
            }
        };
    }

    post(message) {
        const payload = JSON.stringify(message);
        const win = globalThis.chrome && globalThis.chrome.webview;
        if (win && win.postMessage) {
            win.postMessage(payload);
            return true;
        }
        return false;
    }

    refresh() {
        this.loading = true;
        this.error = "";
        if (!this.post({ type: "capabilities" })) {
            this.loading = false;
            this.error = "Native bridge unavailable. Open this page through the OpenDesktop host.";
        }
    }

    closeWindow() {
        this.post({ type: "close" });
    }

    handleReply(data) {
        if (!data || typeof data !== "object" || data.type !== "capabilitiesResult") return;
        this.loading = false;

        if (data.error) {
            const failure = data.error;
            const code = typeof failure.code === "string" ? failure.code : "unavailable";
            const message = typeof failure.message === "string" ? failure.message : String(failure);
            this.error = `${code}: ${message}`;
            this.rows = [];
            return;
        }

        const report = data.report || {};
        this.platform = String(report.platform || "");
        this.rows = [
            this.describe("gui", report.gui),
            ...(Array.isArray(report.protocols) ? report.protocols.map((entry) => this.describe(`protocol ${entry.protocol}`, entry)) : []),
            this.describe("credentials", report.credentials),
        ];
        this.loadedAt = new Date().toLocaleTimeString();
        this.error = "";
    }

    describe(name, capability) {
        const item = capability || {};
        const reason = item.reason || undefined;
        return {
            id: name,
            name,
            state: item.available === true ? "available" : String((reason && reason.code) || "unavailable"),
            detail: item.available === true ? "Reported available by the native capability snapshot." : this.reasonText(reason),
        };
    }

    reasonText(reason) {
        if (!reason) return "Unavailable with no structured reason.";
        if (reason.code === "unsupported_platform") {
            return `Unsupported on ${reason.platform || "this platform"}${reason.detail ? `: ${reason.detail}` : "."}`;
        }
        if (reason.code === "dependency_blocked") {
            return `Blocked on ${reason.dependency || "an external dependency"}${reason.detail ? `: ${reason.detail}` : "."}`;
        }
        if (reason.code === "not_implemented") {
            return `${reason.scope || "This backend"} is not implemented yet.`;
        }
        return String(reason.code);
    }
}
</script>
